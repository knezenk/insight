# ─────────────────────────────────────────────────────────────────────
# INSIGHT · arquivo de variáveis de ambiente
# Copie como .env (NUNCA commitado) e ajuste.
# Todas as CREDENCIAIS vivem AQUI · jamais hardcoded no código.
# ─────────────────────────────────────────────────────────────────────

# ─── Núcleo ──────────────────────────────────────────────────────────
NODE_ENV=production
TZ=America/Sao_Paulo
IMAGE_TAG=latest

# ─── Portas expostas ─────────────────────────────────────────────────
API_PORT=3001
WEB_PORT=8080

# ─── Modo dados · 1=mock, 0=APIs reais ───────────────────────────────
FAKE_DATA=1

# ─── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=false

# ─── CORS ────────────────────────────────────────────────────────────
API_CORS_ORIGINS=https://insight.example.com

# ─── JWT (CRÍTICO trocar em produção) ────────────────────────────────
# Gere um secret forte:  openssl rand -base64 64
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_64
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=insight-api
JWT_AUDIENCE=insight-web

# ─── Rate limiting ───────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# ─── Frontend · Vite ─────────────────────────────────────────────────
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Insight
VITE_APP_VERSION=1.0.0

# ─────────────────────────────────────────────────────────────────────
# APIS EXTERNAS (consumidas quando FAKE_DATA=0)
# ─────────────────────────────────────────────────────────────────────

# Clipping core
CLIPPING_API_BASE_URL=https://api.clipping.example.com
CLIPPING_API_TOKEN=
CLIPPING_API_TIMEOUT_MS=10000

# NLP service (sentimento, IVN, classificação)
NLP_API_BASE_URL=https://nlp.example.com
NLP_API_TOKEN=
NLP_API_TIMEOUT_MS=15000

# Social listening
SOCIAL_API_BASE_URL=https://social.example.com
SOCIAL_API_TOKEN=
SOCIAL_API_TIMEOUT_MS=8000

# Reach/audience
REACH_API_BASE_URL=https://audience.example.com
REACH_API_TOKEN=

# PDF service (Puppeteer)
PDF_SERVICE_URL=
PDF_SERVICE_TIMEOUT_MS=60000

# ─────────────────────────────────────────────────────────────────────
# OBSERVABILIDADE (opcional)
# ─────────────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=insight-api

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─────────────────────────────────────────────────────────────────────
# LIMITES DE RECURSOS DOS CONTAINERS (docker-compose)
# ─────────────────────────────────────────────────────────────────────
API_CPU_LIMIT=1.0
API_MEM_LIMIT=512M
API_MEM_RESERVATION=256M
