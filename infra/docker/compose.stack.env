# Defaults para docker compose (sem precisar de .env na raiz).
# Sobrescreva com arquivo .env local ou com `environment` no compose se precisar.

FAKE_DATA=1
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
API_PREFIX=/api/v1
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=debug
LOG_PRETTY=true
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=insight-api
JWT_AUDIENCE=insight-web
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL=
REDIS_URL=redis://redis:6379
REDIS_TTL_DEFAULT=60
REDIS_TTL_SCORES=300
REDIS_TTL_DICTIONARY=3600
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10
CLIPPING_API_BASE_URL=https://api.clipping.example.com
CLIPPING_API_TOKEN=
CLIPPING_API_TIMEOUT_MS=10000
NLP_API_BASE_URL=https://nlp.example.com
NLP_API_TOKEN=
NLP_API_TIMEOUT_MS=15000
SOCIAL_API_BASE_URL=https://social.example.com
SOCIAL_API_TOKEN=
SOCIAL_API_TIMEOUT_MS=8000
REACH_API_BASE_URL=https://audience.example.com
REACH_API_TOKEN=
PDF_SERVICE_URL=http://pdf:4000
PDF_SERVICE_TIMEOUT_MS=60000
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=insight-api
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_APP_NAME=Insight
VITE_APP_VERSION=1.0.0
VITE_FAKE_DATA=1
VITE_SENTRY_DSN=
